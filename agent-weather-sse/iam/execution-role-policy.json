{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "BedrockInvokeNova",
      "Effect": "Allow",
      "Action": [
        "bedrock:InvokeModel",
        "bedrock:InvokeModelWithResponseStream"
      ],
      "Resource": [
        "arn:aws:bedrock:*::foundation-model/amazon.nova-2-lite-v1:0",
        "arn:aws:bedrock:us-east-1:195275673658:inference-profile/us.amazon.nova-2-lite-v1:0"
      ]
    },
    {
      "Sid": "S3SessionObjects",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject",
        "s3:DeleteObject"
      ],
      "Resource": "arn:aws:s3:::<SESSION_BUCKET>/*"
    },
    {
      "Sid": "S3SessionBucketList",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::<SESSION_BUCKET>"
    }
  ]
}
