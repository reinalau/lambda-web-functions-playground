# AWS region used for Amazon Bedrock and S3. Defaults to us-east-1.
AWS_REGION=us-east-1

# Bedrock model id. Default is Amazon Nova 2 Lite — Amazon's own Bedrock model;
# inference is billed to your AWS Bedrock credits. Model access must be enabled
# in the chosen region.
BEDROCK_MODEL_ID=us.amazon.nova-2-lite-v1:0

# S3 bucket where agent sessions are persisted. REQUIRED in the cloud (the
# Lambda filesystem is ephemeral). If left unset, the agent falls back to
# LocalFileStorage (SESSION_DIR) — intended for local development only.
SESSION_BUCKET=your-session-bucket-name

# Key prefix for session objects stored in SESSION_BUCKET.
SESSION_PREFIX=weather-agent/

# Local directory for sessions when SESSION_BUCKET is unset (local dev only).
SESSION_DIR=./.sessions/

# AWS_LAMBDA_HTTP_ENDPOINT is supplied by Lambda at runtime (host:port form).
# For local development set it yourself, e.g. 127.0.0.1:3000.
# AWS_LAMBDA_HTTP_ENDPOINT=127.0.0.1:3000
