# AWS region used for DynamoDB and for signing calls to the inventory service.
# Must match the region of the inventory endpoint. Defaults to us-east-1.
AWS_REGION=us-east-1

# DynamoDB table that stores orders (PK: id).
ORDERS_TABLE=orders

# Full HTTPS URL of the inventory Lambda Web Function endpoint. The orders BFF
# signs SigV4 requests to this endpoint, e.g.
# https://abc123.lambda-url.us-east-1.on.aws
INVENTORY_ENDPOINT=https://REPLACE_WITH_INVENTORY_ENDPOINT.on.aws

# AWS_LAMBDA_HTTP_ENDPOINT is supplied by Lambda at runtime (host:port form).
# For local development set it yourself, e.g. 127.0.0.1:3000.
# AWS_LAMBDA_HTTP_ENDPOINT=127.0.0.1:3000
