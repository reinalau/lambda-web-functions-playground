# AWS region used for DynamoDB. Defaults to us-east-1.
AWS_REGION=us-east-1

# DynamoDB table that stores inventory items (PK: productId, attributes: productName and available).
INVENTORY_TABLE=inventory

# AWS_LAMBDA_HTTP_ENDPOINT is supplied by Lambda at runtime (host:port form).
# For local development set it yourself, e.g. 127.0.0.1:3001.
# AWS_LAMBDA_HTTP_ENDPOINT=127.0.0.1:3001
